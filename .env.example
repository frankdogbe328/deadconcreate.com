# Dead Concrete example env settings

# App
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
SECURE=false

# Auth
JWT_SECRET=your-very-secure-random-string-at-least-32-chars

# Google Sign-In (optional — leave blank to hide the Google button)
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Type: Web application — add http://localhost:3000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Optional
# SEED_DEMO=true
